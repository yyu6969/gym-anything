{
  "id": "gitlab_env@0.1",
  "version": "0.1",
  "base": "ubuntu-gnome-systemd_highres",
  "runner": "qemu",
  "description": "GitLab Community Edition environment for repository browsing, issue triage, and collaborative software-development workflows using a real GitLab CLI repository and issue backlog.",
  "resources": {
    "cpu": 4,
    "mem_gb": 12,
    "gpu": 0,
    "net": true
  },
  "diagnostics": true,
  "default_cache_level": "post_task",
  "observation": [
    {
      "type": "rgb_screen",
      "fps": 10,
      "resolution": [1920, 1080],
      "inline": false
    }
  ],
  "action": [
    {
      "type": "mouse"
    },
    {
      "type": "keyboard"
    }
  ],
  "synchronous": true,
  "step_cycle_ms": 200,
  "recording": {
    "enable": false,
    "output_dir": "benchmarks/cua_world/environments/gitlab_env/artifacts",
    "video_fps": 10,
    "video_resolution": [1920, 1080],
    "video_codec": "libx264",
    "video_crf": 23
  },
  "vnc": {
    "enable": false,
    "host_port": 5978,
    "view_only": false,
    "password": "password"
  },
  "security": {
    "user": "root",
    "cap_drop": [
      "ALL"
    ],
    "privileged": true,
    "use_systemd": true,
    "mount_cgroups": true,
    "cgroupns_host": true,
    "tmpfs_run": true
  },
  "mounts": [
    {
      "source": "benchmarks/cua_world/environments/gitlab_env/scripts",
      "target": "/workspace/scripts",
      "mode": "ro"
    },
    {
      "source": "benchmarks/cua_world/environments/gitlab_env/config",
      "target": "/workspace/config",
      "mode": "ro"
    },
    {
      "source": "benchmarks/cua_world/environments/gitlab_env/tasks",
      "target": "/workspace/tasks",
      "mode": "ro"
    }
  ],
  "hooks": {
    "pre_start": "'bash /workspace/scripts/install_gitlab.sh'",
    "post_start": "'bash /workspace/scripts/setup_gitlab.sh'"
  },
  "user_accounts": [
    {
      "name": "ga",
      "password": "password123",
      "role": "developer",
      "permissions": {
        "sudo": true,
        "sudo_nopasswd": true,
        "groups": [
          "sudo",
          "audio",
          "video",
          "input",
          "docker"
        ],
        "shell": "/bin/bash",
        "env_vars": {
          "DISPLAY": ":1",
          "GITLAB_URL": "http://gitlab.local"
        }
      }
    }
  ],
  "tags": [
    "linux",
    "gitlab",
    "web-application",
    "devops",
    "issue-tracking",
    "docker"
  ]
}
