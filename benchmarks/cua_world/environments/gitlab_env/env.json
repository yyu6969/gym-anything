{
  "id": "gitlab_env@0.1",
  "version": "0.1",
  "base": "ubuntu-gnome-systemd_highres",
  "runner": "qemu",
  "description": "GitLab environment shared by reconstructed tasks.",
  "resources": {
    "cpu": 4,
    "mem_gb": 12,
    "gpu": 0,
    "net": true
  },
  "diagnostics": true,
  "observation": [
    {
      "type": "rgb_screen",
      "fps": 10,
      "resolution": [
        1920,
        1080
      ],
      "inline": false
    }
  ],
  "action": [
    {
      "type": "mouse"
    },
    {
      "type": "keyboard"
    }
  ],
  "synchronous": true,
  "step_cycle_ms": 200,
  "vnc": {
    "enable": false,
    "password": "password",
    "view_only": false
  },
  "security": {
    "user": "root",
    "privileged": true,
    "use_systemd": true,
    "mount_cgroups": true,
    "cgroupns_host": true,
    "tmpfs_run": true
  },
  "mounts": [
    {
      "source": "./scripts",
      "target": "/workspace/scripts",
      "mode": "ro"
    },
    {
      "source": "./config",
      "target": "/workspace/config",
      "mode": "ro"
    },
    {
      "source": "./assets",
      "target": "/workspace/assets",
      "mode": "ro"
    },
    {
      "source": "./tasks",
      "target": "/workspace/tasks",
      "mode": "ro"
    }
  ],
  "hooks": {
    "pre_start": "'/bin/bash /workspace/scripts/install_gitlab.sh'",
    "post_start": "'/bin/bash /workspace/scripts/setup_gitlab.sh'"
  },
  "user_accounts": [
    {
      "name": "ga",
      "password": "password123",
      "role": "developer",
      "permissions": {
        "sudo": true,
        "sudo_nopasswd": true,
        "groups": [
          "sudo",
          "audio",
          "video",
          "input",
          "docker"
        ],
        "shell": "/bin/bash",
        "env_vars": {
          "DISPLAY": ":1"
        }
      }
    }
  ],
  "default_cache_level": "post_start",
  "tags": [
    "linux",
    "gitlab",
    "source-control",
    "web-application",
    "docker"
  ]
}
